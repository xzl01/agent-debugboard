 *
 * Radxa Linkr Debugger x1.2 (RA051_MB_X1.2) board description.
 *
 * Hardware facts from docs/hardware/RA051_MB_X1.2.pdf:
 *  - RP2354A; external QSPI (U23) not populated, 2 MB internal flash.
 *  - Rails active-high: GPIO0=5V, GPIO1=aux 5V (vdd_5v), GPIO2=12V,
 *    GPIO3=20V. The x1.1 VIO/1V8 regulators are gone.
 *  - Four INA226 on a PIO I2C bus: 20V=0x40, 12V=0x41, 5V=0x44,
 *    aux 5V=0x45, 10 mOhm shunts. Each reports bus voltage, current, power.
 *  - CH224A is on the same bus and is limited to 400 kHz. The shared PIO bus
 *    runs at 400 kHz with production 4.7 kOhm pull-ups to always-on VCC_3V3;
 *    the qualified baseline leaves J8 unloaded. INA226 HS mode still requires
 *    isolation.
 *  - The schematic nets RP2354_SCL/RP2354_SDA are on GPIO20/GPIO21
 *    respectively (SCL=GPIO20, SDA=GPIO21). This is the opposite of the
 *    RP2350 I2C0 pin functions and of the pico-examples SCL=SDA+1 layout,
 *    so the PIO program uses an absolute GPIO wait on SCL.
 *  - ADC0 measures the DC20V input divider (R46=100 kOhm, R47=15 kOhm)
 *    after Q28 and before U10. J8 exposes ADC1..3 on GPIO27..29.
 *  - J4 is a 3-pin target UART (TX/RX/GND): UART1 TX=GPIO10, RX=GPIO11,
 *    exposed through the second USB CDC ACM (cdc_acm_uart1).
 *  - LED_BLUE=GPIO24, TF mux select=GPIO4, TF_WP=GPIO22, OTG enable=GPIO23,
 *    CH224A PD config=GPIO19.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2350a-pinctrl.h>
#include <zephyr/dt-bindings/dma/rpi-pico-dma-rp2350.h>

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,heartbeat-led = &led0;
		radxa-linkr-debugger-temperature-sensor = &die_temp;
		radxa,linkr-gpio-layout = &linkr_gpio_layout;
		radxa,linkr-j4-uart = &uart1;
		radxa,linkr-j4-cdc = &cdc_acm_uart1;
	};

	linkr_gpio_layout: gpio-layout {
		compatible = "radxa,linkr-gpio-layout";
		view = "component-top";

		j8 {
			connector-name = "J8";
			edge = "right";
			order = <0>;
			rows = <10>;
			columns = <2>;

			contact-10 {
				pin-number = <10>;
				row = <0>;
				column = <0>;
				display-label = "GP21 / SDA";
				signal = "RP2354_SDA";
				role = "i2c";
			};

			contact-20 {
				pin-number = <20>;
				row = <0>;
				column = <1>;
				display-label = "5V USB HUB";
				signal = "5V_USB_HUB";
				role = "power";
			};

			contact-9 {
				pin-number = <9>;
				row = <1>;
				column = <0>;
				display-label = "GP20 / SCL";
				signal = "RP2354_SCL";
				role = "i2c";
			};

			contact-19 {
				pin-number = <19>;
				row = <1>;
				column = <1>;
				display-label = "USB DM (hub)";
				signal = "U3_D3M_HUB_CON";
				role = "usb";
			};

			contact-8 {
				pin-number = <8>;
				row = <2>;
				column = <0>;
				display-label = "GP27 / ADC1";
				signal = "GPIO27_ADC1";
				role = "adc";
			};

			contact-18 {
				pin-number = <18>;
				row = <2>;
				column = <1>;
				display-label = "USB DP (hub)";
				signal = "U3_D3P_HUB_CON";
				role = "usb";
			};

			contact-7 {
				pin-number = <7>;
				row = <3>;
				column = <0>;
				display-label = "GP28 / ADC2";
				signal = "GPIO28_ADC2";
				role = "adc";
			};

			contact-17 {
				pin-number = <17>;
				row = <3>;
				column = <1>;
				display-label = "GND";
				signal = "GND";
				role = "ground";
			};

			contact-6 {
				pin-number = <6>;
				row = <4>;
				column = <0>;
				display-label = "GP29 / ADC3";
				signal = "GPIO29_ADC3";
				role = "adc";
				gpio-pin = <29>;
				control-alias = "J8_PIN6";
				controllable;
			};

			contact-16 {
				pin-number = <16>;
				row = <4>;
				column = <1>;
				display-label = "USB MUX";
				signal = "GPIO5";
				role = "dedicated";
			};

			contact-5 {
				pin-number = <5>;
				row = <5>;
				column = <0>;
				display-label = "GP16";
				signal = "GPIO16";
				role = "gpio";
				gpio-pin = <16>;
				control-alias = "J8_PIN5";
				controllable;
				output-capable;
			};

			contact-15 {
				pin-number = <15>;
				row = <5>;
				column = <1>;
				display-label = "TF switch";
				signal = "GP06_TF_SW";
				role = "dedicated";
			};

			contact-4 {
				pin-number = <4>;
				row = <6>;
				column = <0>;
				display-label = "GP15";
				signal = "GPIO15";
				role = "gpio";
				gpio-pin = <15>;
				control-alias = "J8_PIN4";
				controllable;
				output-capable;
			};

			contact-14 {
				pin-number = <14>;
				row = <6>;
				column = <1>;
				display-label = "GND";
				signal = "GND";
				role = "ground";
			};

			contact-3 {
				pin-number = <3>;
				row = <7>;
				column = <0>;
				display-label = "GP14";
				signal = "GPIO14";
				role = "gpio";
				gpio-pin = <14>;
				control-alias = "J8_PIN3";
				controllable;
				output-capable;
			};

			contact-13 {
				pin-number = <13>;
				row = <7>;
				column = <1>;
				display-label = "USB DM";
				signal = "MTT_USB2_DM";
				role = "usb";
			};

			contact-2 {
				pin-number = <2>;
				row = <8>;
				column = <0>;
				display-label = "GP13";
				signal = "GPIO13";
				role = "gpio";
				gpio-pin = <13>;
				control-alias = "J8_PIN2";
				controllable;
				output-capable;
			};

			contact-12 {
				pin-number = <12>;
				row = <8>;
				column = <1>;
				display-label = "USB DP";
				signal = "MTT_USB2_DP";
				role = "usb";
			};

			contact-1 {
				pin-number = <1>;
				row = <9>;
				column = <0>;
				display-label = "GP12";
				signal = "GPIO12";
				role = "gpio";
				gpio-pin = <12>;
				control-alias = "J8_PIN1";
				controllable;
				output-capable;
			};

			contact-11 {
				pin-number = <11>;
				row = <9>;
				column = <1>;
				display-label = "GND";
				signal = "GND";
				role = "ground";
			};
		};

		j13 {
			connector-name = "J13";
			edge = "right";
			order = <1>;
			rows = <2>;
			columns = <2>;

			contact-2 {
				pin-number = <2>;
				row = <0>;
				column = <0>;
				display-label = "GP9 / USER";
				signal = "GP09_USER";
				role = "gpio";
				gpio-pin = <9>;
				control-alias = "CON_USER";
				controllable;
				output-capable;
			};

			contact-3 {
				pin-number = <3>;
				row = <0>;
				column = <1>;
				display-label = "GP8 / RSET";
				signal = "GP08_REST";
				role = "gpio";
				gpio-pin = <8>;
				control-alias = "CON_REST";
				controllable;
				output-capable;
			};

			contact-1 {
				pin-number = <1>;
				row = <1>;
				column = <0>;
				display-label = "GP7 / MASKROM";
				signal = "GP07_MAS";
				role = "gpio";
				gpio-pin = <7>;
				control-alias = "CON_MAS";
				controllable;
				output-capable;
			};

			contact-4 {
				pin-number = <4>;
				row = <1>;
				column = <1>;
				display-label = "GND";
				signal = "GND";
				role = "ground";
			};
		};
	};

	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>;
	};

	ch224a_input_voltage: ch224a-input-voltage {
		compatible = "voltage-divider";
		io-channels = <&adc 0>;
		output-ohms = <15000>;
		full-ohms = <115000>;
		status = "okay";
	};

	reg_12v_out: regulator-12v-out {
		compatible = "regulator-fixed";
		regulator-name = "12v_out";
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
		enable-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		regulator-boot-off;
	};

	reg_5v_out: regulator-5v-out {
		compatible = "regulator-fixed";
		regulator-name = "5v_out";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
		regulator-boot-off;
	};

	reg_vdd_5v: regulator-vdd-5v {
		compatible = "regulator-fixed";
		regulator-name = "vdd_5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
	};

	reg_20v_out: regulator-20v-out {
		compatible = "regulator-fixed";
		regulator-name = "20v_out";
		regulator-min-microvolt = <20000000>;
		regulator-max-microvolt = <20000000>;
		enable-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		regulator-boot-off;
	};

	bootsel_button: bootsel-button {
		compatible = "radxa,linkr-bootsel-button";
		sample-interval-ms = <20>;
		debounce-samples = <3>;
		long-press-ms = <3000>;
		status = "okay";
	};
};

/* PIO I2C master: schematic SCL=GPIO20, SDA=GPIO21. */
&pio0 {
	pio_i2c0: i2c {
		compatible = "raspberrypi,pico-pio-i2c";
		status = "okay";
		/* Production Fast-mode setting; CH224A is limited to 400 kHz. */
		clock-frequency = <400000>;
		pinctrl-0 = <&pio_i2c0_default>;
		pinctrl-names = "default";
		#address-cells = <1>;
		#size-cells = <0>;

		ina226_20v: current-sense@40 {
			compatible = "ti,ina226";
			reg = <0x40>;
			rshunt-micro-ohms = <10000>;
			current-lsb-microamps = <250>;
		};

		ina226_12v: current-sense@41 {
			compatible = "ti,ina226";
			reg = <0x41>;
			rshunt-micro-ohms = <10000>;
			current-lsb-microamps = <250>;
		};

		ina226_5v: current-sense@44 {
			compatible = "ti,ina226";
			reg = <0x44>;
			rshunt-micro-ohms = <10000>;
			current-lsb-microamps = <250>;
		};

		ina226_vdd_5v: current-sense@45 {
			compatible = "ti,ina226";
			reg = <0x45>;
			rshunt-micro-ohms = <10000>;
			current-lsb-microamps = <250>;
		};

		ch224a: ch224a@22 {
			compatible = "wch,ch224a";
			reg = <0x22>;
			/* Initialized explicitly from main after its I2C and sensor dependencies. */
			zephyr,deferred-init;
			maximum-request-millivolt = <20000>;
			input-voltage-sensor = <&ch224a_input_voltage>;
			input-present-threshold-millivolt = <2800>;
			input-absent-threshold-millivolt = <2500>;
			input-present-stable-samples = <3>;
			input-sample-interval-ms = <5>;
			/* R97 is a series link; keep GPIO19 input/no-pull so R81 sets CFG1. */
			cfg1-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
			status = "okay";
		};
	};
};

&pinctrl {
	pio_i2c0_default: pio_i2c0_default {
		sda_pins {
			pinmux = <PIO0_P21>;
			bias-disable;
			input-enable;
			input-schmitt-enable;
		};

		scl_pins {
			pinmux = <PIO0_P20>;
			bias-disable;
			input-enable;
			input-schmitt-enable;
		};
	};

	/* J4 target UART: TX = GPIO10, RX = GPIO11 (UART1 alternate function),
	 * serviced by the project-owned serial runtime.
	 * Use the raw pinmux cell: this Zephyr tree's UART1_*_P10 helpers
	 * reference an undefined RP2_PINCTRL_GPIO_FUNC_UART_ALT symbol, while
	 * RP2350 names function 11 RP2_PINCTRL_GPIO_FUNC_UART_AUX.
	 */
	uart1_default: uart1_default {
		tx_pins {
			pinmux = <RP2XXX_PINMUX(10, RP2_PINCTRL_GPIO_FUNC_UART_AUX)>;
		};

		rx_pins {
			pinmux = <RP2XXX_PINMUX(11, RP2_PINCTRL_GPIO_FUNC_UART_AUX)>;
			input-enable;
		};
	};
};

&gpio0 {
	ch224a_cfg1_release {
		gpio-hog;
		gpios = <19 GPIO_ACTIVE_HIGH>;
		input;
		line-name = "CH224A CFG1 high-impedance";
	};
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&die_temp {
	status = "okay";
};

&led0 {
	gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
};

&zephyr_udc0 {
	cdc_ncm_eth0: cdc_ncm_eth0 {
		compatible = "zephyr,cdc-ncm-ethernet";
		remote-mac-address = "00005E005301";
		local-mac-address = [ 02 2f e3 db 00 01 ];
	};

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "Radxa Linkr Debugger USB CDC ACM";
	};

	cdc_acm_uart1: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
		label = "Radxa Linkr Debugger J4 UART";
	};
};

&pio0 {
	status = "okay";
};

&pio1 {
	status = "okay";
};

&pio2 {
	status = "okay";
};

&dma {
	status = "okay";
};

/* J4 target UART (3-pin TX/RX/GND), UART1 on GPIO10/GPIO11. */
&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
};

/* The board I2C bus is PIO-driven; the hardware I2C peripherals are unused. */
&i2c0 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};
