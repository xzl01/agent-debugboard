#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2350a-pinctrl.h>
#include <zephyr/dt-bindings/dma/rpi-pico-dma-rp2350.h>

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,heartbeat-led = &led0;
		radxa-linkr-debugger-temperature-sensor = &die_temp;
	};

	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>;
	};

	reg_12v_out: regulator-12v-out {
		compatible = "regulator-fixed";
		regulator-name = "12v_out";
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
		enable-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		regulator-boot-off;
	};

	reg_5v_out: regulator-5v-out {
		compatible = "regulator-fixed";
		regulator-name = "5v_out";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
		regulator-boot-off;
	};

	reg_vdd_5v: regulator-vdd-5v {
		compatible = "regulator-fixed";
		regulator-name = "vdd_5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
	};

	reg_20v_out: regulator-20v-out {
		compatible = "regulator-fixed";
		regulator-name = "20v_out";
		regulator-min-microvolt = <20000000>;
		regulator-max-microvolt = <20000000>;
		enable-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		regulator-boot-off;
	};

	reg_1v8_vio: regulator-1v8-vio {
		compatible = "regulator-fixed";
		regulator-name = "1v8_vio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		enable-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_vio: regulator-vio {
		compatible = "regulator-gpio";
		regulator-name = "vio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		regulator-init-microvolt = <3300000>;
		gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
		states = <1800000 0>, <3300000 1>;
	};

	sense_5v_out: current-sense-5v-out {
		compatible = "current-sense-amplifier";
		io-channels = <&adc 0>;
		sense-resistor-milli-ohms = <10>;
		sense-gain-mult = <50>;
		sense-gain-div = <1>;
	};

	sense_12v_out: current-sense-12v-out {
		compatible = "current-sense-amplifier";
		io-channels = <&adc 1>;
		sense-resistor-milli-ohms = <10>;
		sense-gain-mult = <50>;
		sense-gain-div = <1>;
	};

	sense_20v_out: current-sense-20v-out {
		compatible = "current-sense-amplifier";
		io-channels = <&adc 2>;
		sense-resistor-milli-ohms = <10>;
		sense-gain-mult = <50>;
		sense-gain-div = <1>;
	};
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&die_temp {
	status = "okay";
};

&led0 {
	gpios = <&gpio0 25 GPIO_ACTIVE_LOW>;
};

&zephyr_udc0 {
	cdc_ncm_eth0: cdc_ncm_eth0 {
		compatible = "zephyr,cdc-ncm-ethernet";
		remote-mac-address = "00005E005301";
		local-mac-address = [ 02 2f e3 db 00 01 ];
	};

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "Radxa Linkr Debugger USB CDC ACM";
	};
};

&pio0 {
	status = "okay";
};

&pio1 {
	status = "okay";
};

&pio2 {
	status = "okay";
};

&dma {
	status = "okay";
};

&i2c0 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};
