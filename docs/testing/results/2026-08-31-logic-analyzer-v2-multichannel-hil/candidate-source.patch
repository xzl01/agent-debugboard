+		frame, sizeof(frame));
+	assert(len == sizeof(frame));
+	assert(frame[LINKR_DEBUGGER_SIGROK_LINKR_HEADER_BYTES + 5U] ==
+		LINKR_DEBUGGER_SIGROK_LINKR_COMPRESSION_BIT_PACK);
+	assert(memcmp(packed, expected, sizeof(expected)) == 0);
+}
