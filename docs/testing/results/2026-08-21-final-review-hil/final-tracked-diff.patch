-    let mut col_idx = 0usize;
-
-    'outer: for (r, row) in rows.iter().enumerate() {
-        for (c, idx) in row.iter().enumerate() {
-            if *idx == model.control_idx {
-                row_idx = r;
-                col_idx = c;
-                break 'outer;
-            }
-        }
-    }
-
-    if row_delta != 0 {
-        let next_row = (row_idx as isize + row_delta).clamp(0, rows.len() as isize - 1) as usize;
