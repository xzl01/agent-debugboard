-
-    if col_delta != 0 {
-        let next_col = col_idx as isize + col_delta;
-        if next_col >= 0 && (next_col as usize) < rows[row_idx].len() {
-            return rows[row_idx][next_col as usize];
-        }
-        if col_delta < 0 && row_idx > 0 {
-            let prev_row = &rows[row_idx - 1];
