{
  "name": "radxa-linkr-debugger-web",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "test": "node scripts/run-tests.mjs",
    "build": "tsc -b && vite build --config vite.config.ts && node scripts/build-decoder-wasm.mjs",
    "build:firmware": "tsc -b && vite build --config vite.config.ts --mode firmware --base=/ && node scripts/build-decoder-wasm.mjs && node scripts/verify-firmware-build.mjs",
    "preview": "vite preview --config vite.config.ts --host",
    "host": "cargo run --quiet --manifest-path ../host-tools/Cargo.toml -- serve --web-root dist",
    "device-bridge": "node serial-bridge.mjs",
    "serial-bridge": "node serial-bridge.mjs",
    "mcp": "cargo run --quiet --manifest-path ../host-tools/Cargo.toml -- mcp --web-root dist",
    "mcp:node": "node scripts/linkr-mcp-server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/jszip": "^3.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^12.0.0",
    "tailwind-merge": "^2.5.2",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.47",
    "react-grab": "^0.1.50",
    "react-scan": "^0.5.7",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.6"
  }
}
